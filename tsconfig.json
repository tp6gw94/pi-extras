{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true
	},
	"include": ["extensions/ux/**/*.ts", "extensions/hooks/**/*.ts"]
}
