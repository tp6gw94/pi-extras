{
  "name": "pi-extras",
  "version": "0.1.0",
  "description": "A collection of extensions for the pi coding agent.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.extensions.json",
    "test": "node --test --test-timeout=120000 \"extensions/*/test/**/*.test.ts\" \"extensions/*/test/**/*.test.mjs\" extensions/deepinfra-provider/test.mjs extensions/inline-skills/tests/run.mjs"
  },
  "dependencies": {
    "croner": "9.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "@earendil-works/pi-tui": "^1.1.0",
    "node": "^22.23.3",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ]
  }
}
