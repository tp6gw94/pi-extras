{
  "name": "pi-extras",
  "version": "0.1.0",
  "description": "A collection of extensions for the pi coding agent.",
  "type": "module",
  "bin": {
    "pi-annotation": "./extensions/annotation/bin/pi-annotation.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.extensions.json",
    "test": "node --test --test-timeout=120000 test/*.test.ts \"extensions/*/test/**/*.test.ts\" \"extensions/*/test/**/*.test.mjs\" extensions/inline-skills/tests/run.mjs"
  },
  "dependencies": {
    "croner": "9.1.0",
    "grok-mermaid": "0.2.3",
    "mermaid": "12.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.3.0",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "typebox": "^1.3.7",
    "typescript": "^7.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions/*/index.ts"
    ]
  }
}
