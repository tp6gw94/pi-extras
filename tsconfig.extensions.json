{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": false,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["extensions/**/*.ts"],
	"exclude": [
		"extensions/ux/**",
		"extensions/hooks/**",
		"extensions/ralph/**",
		"extensions/skill-name-normalizer/test/**"
	]
}
